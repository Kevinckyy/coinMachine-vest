{
  "manifest_version": 3,
  "name": "VEST Control — Local Browser Bridge",
  "description": "Connect logged-in Vest accounts to local VEST Control for sequential account trading.",
  "version": "0.3.30",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://next.vestmarkets.com/*", "http://127.0.0.1:8765/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "VEST Control Browser Bridge" },
  "content_scripts": [{
    "matches": ["https://next.vestmarkets.com/*"],
    "js": ["core.js", "profit-claim.js", "stop-protection.js", "content.js"],
    "run_at": "document_idle"
  }],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
